[sub_resource type="GDScript" id="GDScript_0pg62"]
script/source = "extends CharacterBody3D

@export_group(\"Unit Stats\")
@export var unit_name: String = \"Max Kael\"
@export var energy_cost: float = 3.0     # ราคาที่ใช้ตอนวาง (Energy)
@export var hp_gain_on_place: int = 10   # HP ที่กองทัพได้รับเพิ่มเมื่อวางตัวนี้ลง
@export var hp_loss_on_death: int = 30   # HP ที่กองทัพจะเสียไปเมื่อตัวนี้ตาย (ปรับให้มากกว่าตอนวางได้!)

# --- สัญญาณบอก Event ---
# ส่งค่า hp_loss ไปเพื่อให้สคริปต์หลักลบแต้มได้ถูกต้อง
signal character_down(hp_to_loss, key)

var is_dead: bool = false
var tile_key: String = \"\"

func _ready():
	set_physics_process(false)

func activate_unit(key: String):
	tile_key = key
	set_physics_process(true)

func _physics_process(_delta):
	if is_dead: return
	
	# เช็กการล้ม (เหมือนเดิม)
	var angle = rad_to_deg(global_transform.basis.y.angle_to(Vector3.UP))
	if angle > 60:
		die()

func die():
	if is_dead: return
	is_dead = true
	
	# ส่งค่า \"HP ที่เสียตอนตาย\" กลับไป
	character_down.emit(hp_loss_on_death, tile_key)
	
	print(unit_name, \" ตายแล้ว! เสีย HP กองทัพ: \", hp_loss_on_death)
	queue_free()
"

